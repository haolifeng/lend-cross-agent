# Administrator wallet credentials for lend-cross-agent.
#
# Copy this file to `.env` and fill in ONE of the options below.
# `.env` is git-ignored — NEVER commit real credentials.
#
# Option A (recommended): a dedicated hardware/externally generated key.
# AGENT_PRIVATE_KEY=0x<64 hex chars>
#
# Option B: BIP39 mnemonic.
# AGENT_MNEMONIC="word1 word2 ... word12"
#
# AGENT_MNEMONIC_PATH is only used with Option B. Defaults to m/44'/60'/0'/0/0.
# AGENT_MNEMONIC_PATH="m/44'/60'/0'/0/0"
